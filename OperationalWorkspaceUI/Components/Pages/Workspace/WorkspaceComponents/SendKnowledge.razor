
@page "/knowledge-page"

@rendermode InteractiveServer

@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using OperationalWorkspaceApplication.DTOs
@using OperationalWorkspaceUI.State
@using OperationalWorkspaceUI.UIServices.Workspace
@using System.Text.RegularExpressions

@inject NavigationManager NavManager
@inject KnowledgeUIService KBService
@inject WorkspaceState WState
@inject Radzen.NotificationService Notifications

<div class="kb-page-container">

    <div class="kb-header">
        <h1 class="kb-title">Knowledge Base</h1>
        <FluentButton Style="background-color: #0b5fff; color: #ffffff; padding: 6px 10px; border-radius: 6px; border: none;"
                      Class="kb-new-btn"
                      OnClick="@CreateArticle">
            New Article
        </FluentButton>
    </div>

    <div class="kb-filter-bar">
        <div class="search-wrapper">
        <FluentSearch Placeholder="Search Sage X3 Articles..."
                          Value="@SearchQuery"
                          ValueChanged="@( (string v) => SearchQuery = v )"
                          Class="full-width" />
        </div>

        <FluentSelect TOption="string" TValue="string"
                      Items="@Categories.Select(c => c.Name)"
                      Value="@SelectedCategory"
                      ValueChanged="@( (string v) => SelectedCategory = v )"
                      Label="Category" />

        <FluentSelect TOption="string" TValue="string"
                      Items="@SortOptions"
                      Value="@SortOrder"
                      ValueChanged="@( (string v) => SortOrder = v )"
                      Label="Sort By" />

        <FluentButton Style="background-color: #efefef; color: #111827; padding: 6px 10px; border-radius: 6px;">
            <FluentIcon Value="@(new Icons.Regular.Size16.Filter())" />
            Filter
        </FluentButton>
    </div>

    <div class="kb-table-container">
        <table class="kb-table">
            <thead>
                <tr class="kb-table-header">
                    <th class="col-check"><FluentCheckbox /></th>
                    <th>ARTICLE TITLE</th>
                    <th>CATEGORY</th>
                    <th class="text-center">VIEWS</th>
                    <th class="text-right">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var article in FilteredArticles)
                {
                    <tr class="kb-row-hover">
                        <td class="col-check">
                            <FluentCheckbox />
                        </td>

                        <td class="col-title">
                            <FluentButton Style="background: transparent; border: none; color: inherit; padding: 0;" 
                                          Class="kb-article-link"
                                          OnClick="@(() => OpenPreview(article))">
                                <FluentIcon Value="@(new Icons.Regular.Size20.Document())"
                                            Class="kb-icon-spacing" />
                                @article.Title
                            </FluentButton>
                        </td>

                        <td class="col-category">@article.Category</td>
                        <td class="col-views">0</td>

                        <td class="col-actions">
                            <FluentButton Style="background: transparent; border: 1px solid #d1d5db; padding: 6px 8px;" 
                                          Class="btn-preview"
                                          OnClick="@(() => OpenPreview(article))">
                                Preview
                            </FluentButton>

                            <FluentButton Style="background-color: #0b5fff; color: #ffffff; padding: 6px 10px; border-radius: 6px;" 
                                          Class="btn-send"
                                          OnClick="@(() => OpenEmailForm(article))">
                                Send
                            </FluentButton>

                            <FluentButton Style="background: transparent; border: none; color: inherit;" 
                                          OnClick="@(() => DeleteArticle(article))">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Delete())"
                                            Color="Color.Error" />
                            </FluentButton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (SelectedArticle != null)
    {
        <div class="modal-backdrop">
            <div class="modal-container">
                @if (!IsSuccessMode)
                {
                    <div class="modal-header">
                        <h2>@(IsEmailMode ? "Send Article" : SelectedArticle.Title)</h2>

                                <FluentButton Style="background: transparent; border: none; color: inherit;"
                                              OnClick="@CloseModal"
                                              Disabled="@IsSending">
                            <FluentIcon Value="@(new Icons.Regular.Size24.Dismiss())" />
                        </FluentButton>
                    </div>

                    <hr class="modal-divider" />

                    @if (IsEmailMode)
                    {
                        <div class="email-form-box">
                            <FluentTextField TValue="string"
                                             Value="@RecipientEmail"
                                             ValueChanged="@OnRecipientEmailChanged"
                                             Placeholder="recipient@company.com"
                                             Label="Recipient Email"
                                             Class="full-width" />

                            @if (!string.IsNullOrEmpty(RecipientEmail) && !IsEmailValid)
                            {
                                <span class="validation-error">Invalid email format.</span>
                            }

                            <div class="modal-footer">
                                <FluentButton Style="background: transparent; border: none; color: inherit;"
                                              OnClick="@CloseModal"
                                              Disabled="@IsSending">
                                    Cancel
                                </FluentButton>

                                <FluentButton Style="background-color: #0b5fff; color: #ffffff; padding: 6px 10px; border-radius: 6px;"
                                              Class="btn-send-confirm"
                                              OnClick="@SendAsAttachment"
                                              Disabled="@(!IsEmailValid || IsSending)">
                                    @(IsSending ? "Sending..." : "Confirm Send")
                                </FluentButton>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="preview-content">
                            <p>@SelectedArticle.Content</p>
                        </div>

                        <div class="modal-footer">
                        <FluentButton Style="background: transparent; border: none; color: inherit; padding: 6px 8px;"
                                          OnClick="@CloseModal">
                                Close
                            </FluentButton>
                        </div>
                    }
                }
                else
                {
                    <div class="success-state">
                        <FluentIcon Value="@(new Icons.Filled.Size32.CheckmarkCircle())"
                                    Color="Color.Success"
                                    Class="success-icon" />
                        <h2 class="success-title">Sent!</h2>
                        <p>Dashboard updated successfully.</p>
                    </div>
                }
            </div>
        </div>
    }

    <div class="kb-footer">
        <FluentAnchor Style="background: transparent; color: inherit;"
                      Href="https://your-sage-x3-url.com"
                      Target="_blank"
                      Class="sage-link">
            Browse Sage X3 →
        </FluentAnchor>

        <div class="pagination-container">
            <span>1 of 1</span>
            <div class="pagination-btns">
                <FluentButton Style="background: transparent; color: inherit;">Prev</FluentButton>
                <FluentButton Style="background: transparent; color: inherit;">Next</FluentButton>
            </div>
        </div>
    </div>
</div>

@code {
    private KnowledgeDto? SelectedArticle;
    private bool IsEmailMode, IsSuccessMode, IsSending;

    private string RecipientEmail = "";
    private string SearchQuery = "";
    private string SelectedCategory = "All Categories";
    private string SortOrder = "Newest";

    private readonly string[] SortOptions = { "Newest", "Most Viewed" };

    private void OpenPreview(KnowledgeDto article)
    {
        SelectedArticle = article;
        IsEmailMode = false;
        IsSuccessMode = false;
    }

    private void OpenEmailForm(KnowledgeDto article)
    {
        SelectedArticle = article;
        IsEmailMode = true;
        IsSuccessMode = false;
    }

    private void CloseModal()
    {
        SelectedArticle = null;
        IsEmailMode = false;
        IsSuccessMode = false;
        IsSending = false;
        RecipientEmail = "";
    }

    private void CreateArticle() =>
        NavManager.NavigateTo("/forms/send-knowledge");

    private void OnRecipientEmailChanged(string? value)
    {
        RecipientEmail = value ?? "";
    }

    private async Task SendAsAttachment()
    {
        if (SelectedArticle == null || !IsEmailValid)
            return;

        WState.SetSendingKnowledge(true);
        IsSending = true;

        try
        {
            await Task.Delay(1500);

            await KBService.SendKnowledgeAsync(new SendKnowledgeModel
            {
                SearchQuery = SelectedArticle.Title,
                Message = RecipientEmail
            });

            IsSuccessMode = true;
            IsSending = false;
            StateHasChanged();

            await Task.Delay(2000);
            CloseModal();
        }
        finally
        {
            WState.SetSendingKnowledge(false);
        }
    }

    private void DeleteArticle(KnowledgeDto article)
    {
        WState.KnowledgeBase.Remove(article);
        WState.LogActivity(article.Title, "Deleted Article", "Tia");

        Notifications.Notify(new Radzen.NotificationMessage
        {
            Severity = Radzen.NotificationSeverity.Info,
            Summary = "Deleted",
            Detail = "Article removed from global state."
        });

        WState.Notify();
    }

    private bool IsEmailValid =>
        Regex.IsMatch(
            RecipientEmail,
            @"^[^@\s]+@[^@\s]+\.[^@\s]+$");

    private List<CategoryItem> Categories = new()
    {
        new("All Categories"),
        new("Pricing Guidelines"),
        new("Product Documentation"),
        new("Case Studies"),
        new("FAQ"),
        new("How To Guides")
    };

    private IEnumerable<KnowledgeDto> FilteredArticles =>
        WState.KnowledgeBase
            .Where(a =>
                (SelectedCategory == "All Categories" ||
                 a.Category == SelectedCategory) &&
                (string.IsNullOrWhiteSpace(SearchQuery) ||
                 a.Title.Contains(
                     SearchQuery,
                     StringComparison.OrdinalIgnoreCase)));

    public record CategoryItem(string Name);
}
