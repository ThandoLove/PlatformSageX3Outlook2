@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using Orientation = Microsoft.FluentUI.AspNetCore.Components.Orientation


@inject NavigationManager NavigationManager
@inject EmailContextState EmailState
@inject Radzen.NotificationService NotificationService


<FluentCard Style="padding: 10px; margin-top: 10px; background-color: #fafafa;">
    <FluentStack Orientation="Orientation.Horizontal"
                 Spacing="3"
                 HorizontalAlignment="HorizontalAlignment.Center">
        
        <FluentButton Style="background: transparent; border: 1px solid #d1d5db; padding: 6px 12px;"
                      IconStart="@(new Icons.Regular.Size20.ContactCard())"
                      OnClick="@GoToCreateContact">
            Create Contact
        </FluentButton>

        <FluentButton Style="background: transparent; border: 1px solid #d1d5db; padding: 6px 12px;"
                      IconStart="@(new Icons.Regular.Size20.Link())"
                      OnClick="@GoToLinkRecord">
            Link to Existing
        </FluentButton>

        <FluentButton Style="background-color: #111827; color: white; padding: 6px 12px;"
                      IconStart="@(new Icons.Regular.Size20.Cart())"
                      OnClick="@GoToCreateOrder">
            Sales Order
        </FluentButton>

        <FluentButton Style="background: transparent; border: 1px solid #d1d5db; padding: 6px 12px;"
                      IconStart="@(new Icons.Regular.Size20.DocumentAdd())"
                      OnClick="@GoToCreateInvoice">
            Create Invoice
        </FluentButton>

    </FluentStack>
</FluentCard>

@code {
    private void GoToCreateContact() => NavigationManager.NavigateTo("/forms/create-contact");
    private void GoToLinkRecord() => NavigationManager.NavigateTo("/forms/link-record");
    private void GoToCreateOrder() => NavigationManager.NavigateTo("/forms/create-order");
    private void GoToCreateInvoice() => NavigationManager.NavigateTo("/forms/create-invoice");
}

