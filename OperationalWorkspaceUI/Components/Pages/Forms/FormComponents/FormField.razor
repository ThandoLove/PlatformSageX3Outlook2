
@using Microsoft.AspNetCore.Components.Forms

<div style="margin-bottom: 12px; width: 100%;">
    @if (Type.Equals("textarea", StringComparison.OrdinalIgnoreCase))
    {
        <div style="width: 100%;">
            <label>@Label</label>
            <InputTextArea @bind-Value="Value"
                           class="form-control"
                           rows="4"
                           style="width: 100%;" />
        </div>
    }
    else if (Type.Equals("select", StringComparison.OrdinalIgnoreCase)
             && Options is not null)
    {
        <div style="width: 100%;">
            <label>@Label</label>
            <InputSelect TValue="string"
                         Value="Value"
                         ValueChanged="OnValueChanged"
                         ValueExpression="@(() => Value)"
                         class="form-control"
                         style="width: 100%;">
                @foreach (var opt in Options)
                {
                    <option value="@opt.Key">@opt.Value</option>
                }
            </InputSelect>
        </div>
    }
    else
    {
        <div style="width: 100%;">
            <label>@Label</label>
            <InputText @bind-Value="Value"
                       type="@GetInputType(Type)"
                       class="form-control"
                       style="width: 100%;" />
        </div>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Type { get; set; } = "text";

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public List<KeyValuePair<string, string>>? Options { get; set; }

    private Task OnValueChanged(string? value)
    {
        Value = value;
        return ValueChanged.InvokeAsync(value);
    }

    private static string GetInputType(string type) =>
        type.ToLowerInvariant() switch
        {
            "password" => "password",
            "email" => "email",
            "tel" => "tel",
            "number" => "number",
            _ => "text"
        };
}