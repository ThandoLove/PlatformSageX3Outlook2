@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using OperationalWorkspaceUI.Components.Pages.Forms.FormComponents
@using OperationalWorkspaceUI.UIServices.System
@using OperationalWorkspaceApplication.DTOs
@using OperationalWorkspaceUI.State

@inject OperationalWorkspaceUI.UIServices.Workspace.BusinessPartnerUIService BPService
@inject OperationalWorkspaceUI.State.WorkspaceState WorkspaceState
@inject DashboardState DState
@inject Radzen.NotificationService NotificationService
@inject ModalService ModalService
@inject NavigationManager NavManager

@{
    var currentPath = NavManager.ToBaseRelativePath(NavManager.Uri).ToLowerInvariant();
    bool isEmbeddedModal = currentPath.Contains("dashboard") || currentPath.Contains("workspace");
}

@if (isEmbeddedModal)
{
    <div class="modal-form-inline-title">
        <h2>Create Sage X3 Client</h2>
    </div>

    @FormFieldsLayout
}
else
{
    <FormSection Title="Create Sage X3 Client"
                 SubmitLabel="Save Client to Sage"
                 OnSubmit="SaveClientAsync"
                 OnCancel="HandleCancel">
        @FormFieldsLayout
    </FormSection>
}

@code {
    [Parameter] public string? Email { get; set; }
    [Parameter] public string? FullName { get; set; }

    private ClientDto NewClient = new();
    private static readonly string[] ClientCategories = new[] { "DOM", "INT", "EU" };

    private RenderFragment FormFieldsLayout => __builder =>
    {
        <EditForm Model="NewClient" OnValidSubmit="SaveClientAsync">
            <DataAnnotationsValidator />

            @* SECTION 1: IDENTITY & CATEGORY *@
            <div class="sage-form-group">
                <FluentLabel Typo="Typography.Body">BUSINESS IDENTITY</FluentLabel>
                <div class="form-grid-2-col">
                    <div>
                        <FluentTextField TValue="string" Label="Client Name" Value="@NewClient.Name" ValueChanged="@( (string v) => NewClient.Name = v )" FullWidth="true" />
                        <ValidationMessage For="@(() => NewClient.Name)" />
                    </div>
                <FluentSelect TOption="string" TValue="string" Label="Client Category" FullWidth="true"
                                  Items="@ClientCategories"
                                  Value="@NewClient.Category" ValueChanged="@( (string v) => NewClient.Category = v )" />
                </div>
                <div class="single-field-row">
                    <FluentTextField Label="Tax / VAT Number" Placeholder="e.g. GB123456789" FullWidth="true" />
                </div>
            </div>

            @* SECTION 2: CONTACT INFORMATION *@
            <div class="sage-form-group">
                <FluentLabel Typo="Typography.Body">CONTACT INFO</FluentLabel>
                <div class="single-field-row">
                    <FluentTextField TValue="string" Label="Email Address" Value="@NewClient.Email" ValueChanged="@( (string v) => NewClient.Email = v )" FullWidth="true" />
                </div>

                <div class="form-grid-2-col">
                    <FluentTextField TValue="string" Label="Phone Number" Value="@NewClient.PhoneNumber" ValueChanged="@( (string v) => NewClient.PhoneNumber = v )" FullWidth="true" />
                    <FluentTextField Label="Website" Placeholder="https://" FullWidth="true" />
                </div>
            </div>

            @* SECTION 3: ADDRESS *@
            <div class="sage-form-group">
                <FluentLabel Typo="Typography.Body">LOCATION</FluentLabel>
                <div class="single-field-row">
                <FluentTextArea TValue="string" Label="Full Address" Value="@NewClient.Address" ValueChanged="@( (string v) => NewClient.Address = v )" Rows="3" FullWidth="true" />
                </div>

                <div class="form-grid-2-col">
                    <FluentTextField Label="City" FullWidth="true" />
                    <FluentTextField Label="Postal Code" FullWidth="true" />
                </div>
            </div>

            @* UNIVERSAL ACTION FOOTER BAR *@
            <div class="form-footer">
                @* 🚀 FIXED: Fully-qualified ButtonType names completely remove Radzen conflict lookup bugs *@
                <FluentButton Type="@Microsoft.FluentUI.AspNetCore.Components.ButtonType.Button" OnClick="@(() => HandleCancel())">Cancel</FluentButton>
                <FluentButton Type="@Microsoft.FluentUI.AspNetCore.Components.ButtonType.Submit" Class="sage-submit-btn" Style="background-color: #1b5e20; color: white;">Save Client to Sage</FluentButton>
            </div>
        </EditForm>
    };

    protected override void OnInitialized()
    {
        NewClient.Name = !string.IsNullOrEmpty(FullName) ? FullName : (DState?.EmailContext?.SenderName ?? string.Empty);
        NewClient.Email = !string.IsNullOrEmpty(Email) ? Email : (DState?.EmailContext?.SenderEmail ?? string.Empty);
    }

    private async Task SaveClientAsync()
    {
        var success = await BPService.CreateClientAsync(NewClient);

        if (success)
        {
            WorkspaceState.ReloadClients();

            NotificationService.Notify(new Radzen.NotificationMessage
            {
                Severity = Radzen.NotificationSeverity.Success,
                Summary = "Sage X3 Updated",
                Detail = $"{NewClient.Name} has been created successfully.",
                Duration = 4000
            });

            DState.ShowAddClientUI = false;
            DState.NotifyStateChanged();

            await CleanseViewOverlayAsync();
        }
        else
        {
            NotificationService.Notify(new Radzen.NotificationMessage
            {
                Severity = Radzen.NotificationSeverity.Error,
                Summary = "Sync Error",
                Detail = "Could not create client in Sage X3."
            });
        }
    }

    // 🚀 FIXED: Converted to a non-returning async Task tracking path wrapper to clear the CS1662 lambda exception
    private async Task HandleCancel()
    {
        DState.ShowAddClientUI = false;
        DState.NotifyStateChanged();
        await CleanseViewOverlayAsync();
    }

    private async Task CleanseViewOverlayAsync()
    {
        var currentPath = NavManager.ToBaseRelativePath(NavManager.Uri).ToLowerInvariant();
        if (currentPath.Contains("dashboard") || currentPath.Contains("workspace"))
        {
            await ModalService.CloseModal();
        }
        else
        {
            NavManager.NavigateTo("/dashboard");
        }
    }
}
